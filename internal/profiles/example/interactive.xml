<?xml version="1.0" encoding="utf-8"?>
<!--
  Kyro example profile "interactive": Windows Setup, with no question
  answered.

  It exists so that you can try Kyro, and driver packs, on a machine whose
  disk has to stay as it is. Kyro starts the machine into Windows PE, loads
  the driver packs, connects the install share and starts Windows Setup.
  From there on Setup asks on the screen, as it does when started from a
  USB stick.

  What it does:
    - Answers none of Setup's questions: language, edition, license terms
      and the disk are asked on the screen. Setup installs nothing until a
      person at the machine picks a disk there and goes on.
    - If a person does install Windows that way: at the first logon, the
      installed system tells Kyro that the installation is complete.

  What it is for: Setup's disk page ("Where do you want to install
  Windows?") lists the disks that Windows PE can see with the drivers it was
  given. Shift+F10 opens a command prompt there. Closing Setup's window
  ends the test.

  What it does not prevent: Windows PE treats the disks of the machine as a
  Windows installation USB stick does. It reads the file systems it knows,
  and in doing so writes its own bookkeeping into NTFS volumes. Partitions
  and files stay as they are.

  Copyright (C) 2026 Lukas Koch and Kyro contributors
  SPDX-License-Identifier: GPL-3.0-or-later
-->
<unattend xmlns="urn:schemas-microsoft-com:unattend" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">
  <settings pass="oobeSystem">
    <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <FirstLogonCommands>
        <SynchronousCommand wcm:action="add">
          <Order>1</Order>
          <Description>Tell Kyro that the installation is complete</Description>
          <CommandLine>cmd /c curl.exe --silent --show-error --fail --retry 30 --retry-delay 5 --retry-all-errors --max-time 20 -X POST {{callback_url}}</CommandLine>
        </SynchronousCommand>
      </FirstLogonCommands>
    </component>
  </settings>
</unattend>
