# Kyro - PXE server for installing Windows over the network.
# Installed by install.sh as /etc/systemd/system/kyro.service.
# docs/install.md explains every line of the sandbox below.

[Unit]
Description=Kyro PXE server for installing Windows over the network
Documentation=https://github.com/kyro-pxe/kyro
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=kyro
Group=kyro
ExecStart=/usr/local/bin/kyro serve --config /etc/kyro/config.yaml
Restart=on-failure
RestartSec=5

# The one capability Kyro needs: binding ports below 1024 (DHCP 67, TFTP 69,
# HTTP 80, SMB 445) without being root. It is also the only one the service
# could ever get.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# The file system is read-only for the service, except for the client state.
# Images, profiles and boot files are changed by the CLI, not by the service.
ProtectSystem=strict
ReadWritePaths=/var/lib/kyro/state
# Read-only and not hidden: an ISO that was added with --link may live there.
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
UMask=0027

ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible

# IPv4 for the services, netlink to look up the boot interface, Unix sockets
# for logging. IPv6 is listed because Go probes for it at start.
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
